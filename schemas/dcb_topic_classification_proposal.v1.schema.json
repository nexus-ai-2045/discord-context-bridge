{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus-ai-2045.github.io/discord-context-bridge/schemas/dcb_topic_classification_proposal.v1.schema.json",
  "title": "DCB append-only topic classification proposal v1",
  "type": "object",
  "required": ["schema", "proposal_id", "packet_id", "observation_id", "topics", "review_status", "private_local_only"],
  "properties": {
    "schema": {"const": "dcb.topic_classification_proposal.v1"},
    "proposal_id": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "observation_id": {"type": "string", "pattern": "^observation-[a-f0-9]{12}$"},
    "topics": {"type": "array"},
    "review_status": {"const": "pending_human_review"},
    "private_local_only": {"const": true}
  }
}
